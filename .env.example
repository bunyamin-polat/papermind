# Copy to .env and adjust. .env is gitignored; this file is committed.
# docker-compose.yml reads these too, so the container and the app can never
# disagree about credentials — one source of truth.

POSTGRES_USER=papermind
POSTGRES_PASSWORD=papermind-local-dev
POSTGRES_DB=papermind

# Host side of the port mapping. 5432 is usually taken by a Postgres installed
# directly on the machine, and 5433 by whatever you tried second — so pick any
# free port here. Inside the Docker network the container still listens on 5432,
# which is why only the left-hand side of the mapping ever changes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Not needed until step 5 (RAG generation). Leave empty for now.
OPENAI_API_KEY=
