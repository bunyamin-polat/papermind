# Copy to backend.hcl and fill in the bucket created by 00_bootstrap:
#
#   cd terraform/stacks/00_bootstrap && terraform output -raw state_bucket_name
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored — the bucket name contains the account ID.
# Workspaces keep dev and prod apart automatically: each writes to env:/<workspace>/<key>.

bucket = "slipway-tfstate-000000000000"
key    = "20_app/terraform.tfstate"
region = "us-east-1"

encrypt      = true
use_lockfile = true
