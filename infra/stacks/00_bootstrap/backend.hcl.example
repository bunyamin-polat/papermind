# Backend configuration, kept out of the repository because the bucket name contains
# the AWS account ID. Copy to backend.hcl and fill in from `terraform output`:
#
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl -migrate-state
#
# backend.hcl is gitignored. backend.hcl.example is what gets committed.

bucket = "slipway-tfstate-000000000000"
key    = "00_bootstrap/terraform.tfstate"
region = "us-east-1"

encrypt = true

# Native S3 locking, available since Terraform 1.10. No DynamoDB table needed —
# that mechanism was deprecated in 1.11.
use_lockfile = true
