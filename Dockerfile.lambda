# The deployed image: API only, corpus baked in, no database.
#
# Different from `Dockerfile` on purpose. That one is for `docker compose` and talks to
# Postgres; this one carries the corpus as a 115 MB artifact and searches it with numpy.
# The reason is measured rather than architectural taste — at 30,061 vectors brute force
# takes 2.9 ms against pgvector-with-HNSW's 3.7 ms, so the database earns nothing in a
# read-only deployment while costing an RDS instance, a VPC and a NAT gateway (~$45/mo).
#
# `tests/test_backend_parity.py` is what makes two images acceptable: it asserts the
# numpy backend returns exactly what exact search returns, on the real evaluation
# questions. Two backends that drift apart quietly would be the worst kind of bug this
# project has produced, and it has produced several.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev


FROM python:3.12-slim AS runtime

# The adapter is a Lambda extension: it turns Lambda invocations into ordinary HTTP
# against 127.0.0.1:$PORT, which is why there is no Lambda-specific code anywhere in the
# app. On a plain `docker run` the extension is never started and the same image serves
# HTTP directly — so App Runner and a laptop run exactly what Lambda runs.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

ENV PORT=8080 \
    AWS_LWA_INVOKE_MODE=response_stream \
    # Liveness only. /health calls the language model, and readiness that depends on a
    # third party is readiness that fails for reasons the container cannot fix.
    AWS_LWA_READINESS_CHECK_PATH=/healthz \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/hf \
    # No database. The corpus travels with the image.
    RETRIEVAL_BACKEND=memory \
    ARTIFACT_DIR=/app/data/artifact \
    LLM_PROVIDER=openai

RUN useradd --create-home --uid 1000 papermind \
 && mkdir -p /app /opt/hf \
 && chown papermind:papermind /app /opt/hf

WORKDIR /app
USER papermind

COPY --from=builder --chown=papermind:papermind /app/.venv /app/.venv

RUN python -c "from sentence_transformers import SentenceTransformer; \
               SentenceTransformer('BAAI/bge-base-en-v1.5')"
ENV HF_HUB_OFFLINE=1

# 115 MB: 88 MB of vectors and 21 MB of text. Built by `scripts/build_artifact.py`
# against a populated database, and checked into the image rather than fetched at boot —
# the same reasoning as the model above. A cold start that depends on the network is a
# cold start that fails for reasons nobody can see.
COPY --chown=papermind:papermind data/artifact/ ./data/artifact/

COPY --chown=papermind:papermind core/ ./core/
COPY --chown=papermind:papermind retrieval/ ./retrieval/
COPY --chown=papermind:papermind app/ ./app/

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
